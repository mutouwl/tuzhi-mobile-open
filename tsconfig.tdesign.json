{
  "compilerOptions": {
    "target": "ES2015",
    "module": "commonjs",
    "lib": ["ES2016", "DOM"],
    "outDir": "./node_modules/@tdesign/uniapp/dist",
    "rootDir": "./node_modules/@tdesign/uniapp/dist",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "allowJs": false,
    "checkJs": false,
    "resolveJsonModule": true,
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "node_modules/@tdesign/uniapp/dist/**/*.ts"
  ],
  "exclude": [
    "node_modules/@tdesign/uniapp/dist/**/*.d.ts",
    "node_modules/@tdesign/uniapp/dist/**/*.vue"
  ]
}
